      'location': 'Bhola, Barishal Division',
      'duration': '0:45'
    },
    {
      'title': 'বরিশাল কীর্তনখোলা নদীর ট্রলার ভ্রমণ ও হাটের দৃশ্য',
      'location': 'Barishal Sadar',
      'duration': '0:30'
    },
    {
      'title': 'কুয়াকাটা সমুদ্র সৈকতে সকালের সূর্যাস্ত',
